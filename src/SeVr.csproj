<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Space VR</AssemblyName>
    <RootNamespace>SeVr</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.5.0</Version>
    <OutputPath>..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameBin Condition="'$(GameBin)'==''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</GameBin>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VRage"><HintPath>$(GameBin)\VRage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(GameBin)\VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(GameBin)\VRage.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(GameBin)\VRage.Render.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Render11"><HintPath>$(GameBin)\VRage.Render11.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Input"><HintPath>$(GameBin)\VRage.Input.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(GameBin)\VRage.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX"><HintPath>$(GameBin)\SharpDX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.D3DCompiler"><HintPath>$(GameBin)\SharpDX.D3DCompiler.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(GameBin)\SharpDX.Direct3D11.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(GameBin)\SharpDX.DXGI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(GameBin)\Sandbox.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(GameBin)\Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>



